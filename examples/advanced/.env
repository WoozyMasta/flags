# This .env file is picked up automatically only when you run the binary
# from *this* directory. The DotEnv option looks for ".env" in the current
# working directory, so the effect depends on where you launch the program:
#
#   From the project root - .env is NOT loaded:
#     go run ./examples/advanced/ env
#
#   From this directory - .env IS loaded:
#     cd examples/advanced && go run . env

# Sets the --profile flag default via the DEMO_APP_PROFILE env var.
# DEMO_APP_ prefix comes from parser.SetEnvPrefix("DEMO_APP");
# "profile" key is derived from the long flag name via auto-env:"true".
DEMO_APP_PROFILE="production"

# Expansion example: use the current USER if set, fall back to "nobody".
# The := operator writes the default into the local .env variable map;
# the outer LoadDotEnv call then sets USER in the process environment only
# if it was not already defined there.
USER="${USER:=${USERNAME:=nobody}}"
